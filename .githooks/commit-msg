#!/bin/bash

COMMIT_MSG=$(cat "$1")

# Allow merge commits (auto-generated by Git)
if echo "$COMMIT_MSG" | grep -qE "^Merge "; then
  exit 0
fi

# Allow the initial project setup commit (exception stated in project spec)
if echo "$COMMIT_MSG" | grep -qE "^init: .+"; then
  exit 0
fi

# Pattern: type(service): description (student-id)
# e.g. feat(user-service): add User entity model (55-8078)
# e.g. fix(ride-service): fix null handling in search query (55-8078)
PATTERN="^(feat|fix|bugfix|hotfix|release|docs|refactor|test|chore)\([a-z][a-z0-9-]*\): .{1,100} \([0-9]+-[0-9]+\)$"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "Commit message does not follow the required format."
  echo ""
  echo "   Required : type(service): description (student-id)"
  echo "   Example  : feat(user-service): add User entity model (55-8078)"
  echo "   Example  : fix(ride-service): fix null handling in search query (55-8078)"
  echo ""
  echo "   Allowed types : feat, fix, bugfix, hotfix, release, docs, refactor, test, chore"
  echo "   Your message  : $COMMIT_MSG"
  echo ""
  exit 1
fi
