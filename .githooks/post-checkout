#!/bin/bash

# Prevent re-entry: git checkout - below would trigger this hook again
if [ -n "$POST_CHECKOUT_RUNNING" ]; then
  exit 0
fi
export POST_CHECKOUT_RUNNING=1

# Only run on branch checkouts, not file checkouts
if [ "$3" != "1" ]; then
  exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

# Skip validation in detached HEAD state (e.g. checking out a tag or commit)
if [ -z "$BRANCH" ] || [ "$BRANCH" = "HEAD" ]; then
  exit 0
fi

# Allow protected/base branches through without checks
if echo "$BRANCH" | grep -qE "^(main|master|develop)$"; then
  exit 0
fi

# Allow local-only parallel-agent worktree branches (never pushed; orchestrator-managed).
if echo "$BRANCH" | grep -qE "^worktree-agent-"; then
  exit 0
fi

# M3 §13.1 branch format — the only accepted pattern from M3 onward.
#   <type>/M3/<ID>/<student-id>
#     e.g. feat/M3/S5-INFRA/55-24853
#   <type>/M3/<scope>/<ID>/<student-id>          (per-feature blocks in §3–§7)
#     e.g. feat/M3/payment/S5-F4/55-24853
# The earlier M1/M2 format <type>/<service>/<feature>/<id> is no longer accepted.
TYPE='(feat|fix|bugfix|hotfix|release|docs|refactor|test|chore)'
SEG='[A-Za-z0-9][A-Za-z0-9._-]*'
STUDENT='[0-9]+-[0-9]+'
PATTERN="^${TYPE}/M3/${SEG}(/${SEG})?/${STUDENT}$"

if ! echo "$BRANCH" | grep -qE "$PATTERN"; then
  echo ""
  echo "Branch '$BRANCH' does not follow the M3 naming convention (§13.1)."
  echo ""
  echo "   Required : <type>/M3/<ID>/<student-id>"
  echo "   Required : <type>/M3/<scope>/<ID>/<student-id>"
  echo ""
  echo "   Examples : feat/M3/S5-INFRA/55-24853"
  echo "              feat/M3/payment/S5-F4/55-24853"
  echo "              chore/M3/githooks/55-24853"
  echo ""
  echo "   Allowed types : feat, fix, bugfix, hotfix, release, docs, refactor, test, chore"
  echo ""
  echo "   The pre-M3 format (<type>/<service>/<feature>/<id>) is no longer accepted."
  echo "   To check out a historical M1/M2 branch, run with --no-verify or temporarily"
  echo "   set core.hooksPath to empty: git -c core.hooksPath= checkout <branch>."
  echo ""
  git checkout -
  git branch -d "$BRANCH" 2>/dev/null
  exit 1
fi
