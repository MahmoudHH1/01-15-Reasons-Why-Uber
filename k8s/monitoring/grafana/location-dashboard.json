{
  "uid": "location-service-dashboard",
  "title": "Location Service Dashboard",
  "tags": ["uber", "location-service"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "description": "Requests per second per endpoint for location-service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(http_server_requests_seconds_count{service=\"location-service\"}[5m])",
          "legendFormat": "{{uri}} {{method}} {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "id": 2,
      "title": "HTTP Latency Percentiles (P50 / P95 / P99)",
      "type": "timeseries",
      "description": "Response time percentiles for location-service endpoints",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service=\"location-service\"}[5m])))",
          "legendFormat": "P50 {{uri}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service=\"location-service\"}[5m])))",
          "legendFormat": "P95 {{uri}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service=\"location-service\"}[5m])))",
          "legendFormat": "P99 {{uri}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 3,
      "title": "JVM Heap Usage",
      "type": "timeseries",
      "description": "JVM heap memory used vs committed for location-service",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_memory_used_bytes{area=\"heap\", service=\"location-service\"}",
          "legendFormat": "Heap Used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_memory_committed_bytes{area=\"heap\", service=\"location-service\"}",
          "legendFormat": "Heap Committed",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(jvm_gc_pause_seconds_sum{service=\"location-service\"}[5m]))",
          "legendFormat": "GC Pause Total (5m)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 4,
      "title": "RabbitMQ Consumer Rate (location-service)",
      "type": "timeseries",
      "description": "Rate of saga events consumed (ride.placed / ride.completed / ride.cancelled)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(spring_rabbitmq_listener_seconds_count{service=\"location-service\"}[5m])",
          "legendFormat": "Consumer Rate {{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "mps" }
      }
    },
    {
      "id": 5,
      "title": "Error Rate (location-service logs)",
      "type": "timeseries",
      "description": "Count of ERROR-level log lines per minute — spike detection",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({app=\"uber\", service=\"location-service\", level=\"ERROR\"}[1m]))",
          "legendFormat": "ERROR/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "RabbitMQ Event Audit (location-service)",
      "type": "logs",
      "description": "Log lines emitted by saga consumers — ride.placed / ride.completed / ride.cancelled",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"uber\", service=\"location-service\"} |= \"routingKey\" | json | line_format \"[{{.routingKey}}] {{.message}}\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Feign Call Outcomes (location-service → driver-service)",
      "type": "logs",
      "description": "Successful Feign responses vs FeignException catches for driver-service calls",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{app=\"uber\", service=\"location-service\"} |= \"driver-service\" | json | line_format \"[{{.level}}] driverId={{.driverId}} {{.message}}\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }
  ]
}
